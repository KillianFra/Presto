NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase — pooled connection (PgBouncer, port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — direct connection (port 5432) used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Local dev alternative (replace the two URLs above when running docker compose)
# DATABASE_URL="postgresql://presto:presto@localhost:5432/presto?schema=public"
# DIRECT_URL="postgresql://presto:presto@localhost:5432/presto?schema=public"
